<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Analogi.App.Views.Pages.ComparePage"
             x:DataType="vm:CompareViewModel">

    <DockPanel Margin="28,24">
        <!-- Header with back button -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <Button Grid.Column="0" Command="{Binding GoBackCommand}"
                    Padding="8,6" Background="Transparent" CornerRadius="6"
                    VerticalAlignment="Center" Margin="0,0,12,0"
                    ToolTip.Tip="Back to Results">
                <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                          Width="16" Height="16"/>
            </Button>
            <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Compare" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SimilarityText}"
                           IsVisible="{Binding HasComparison}"
                           FontSize="14" Opacity="0.7"/>
            </StackPanel>
        </Grid>

        <!-- Empty state -->
        <Border IsVisible="{Binding !HasComparison}"
                CornerRadius="8" Padding="48"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <PathIcon Data="M8.293 3.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1-1.414 1.414L10 6.414V17.5a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5V6.414L5.707 8.707a1 1 0 0 1-1.414-1.414l4-4zM14 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v11.086l2.293-2.293a1 1 0 0 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 1.414-1.414L14 17.586V6.5z"
                          Width="32" Height="32" Opacity="0.3"/>
                <TextBlock Text="No Comparison Selected" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a pair from the Results page&#10;to view side-by-side comparison."
                           TextAlignment="Center" Opacity="0.5" FontSize="13" LineHeight="20"/>
            </StackPanel>
        </Border>

        <!-- Comparison view -->
        <DockPanel IsVisible="{Binding HasComparison}">
            <!-- File pair selector (submission mode only) -->
            <Border DockPanel.Dock="Top"
                    IsVisible="{Binding IsSubmissionMode}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="File pair:" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                    <ComboBox ItemsSource="{Binding FilePairs}"
                              SelectedItem="{Binding SelectedFilePair}"
                              MinWidth="300" FontSize="12"
                              x:CompileBindings="False">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding FileA.Name}"/>
                                    <Run Text=" ↔ " Foreground="Gray"/>
                                    <Run Text="{Binding FileB.Name}"/>
                                    <Run Text=" (" Foreground="Gray"/>
                                    <Run Text="{Binding SimilarityPercent}"/>
                                    <Run Text="%)" Foreground="Gray"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Reasons panel -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,12,0,0"
                    MaxHeight="130" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Analysis Breakdown" FontWeight="Medium" FontSize="12"/>
                        <TextBlock Text="{Binding ReasonsText}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" LineHeight="18"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Side-by-side code -->
            <Grid ColumnDefinitions="*,1,*">
                <Border Grid.Column="0" CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock Text="{Binding HeaderA}" FontWeight="Medium" FontSize="12"/>
                        </Border>
                        <ae:TextEditor x:Name="EditorA"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       FontFamily="Cascadia Code,JetBrains Mono,Consolas,monospace"
                                       FontSize="12"/>
                    </DockPanel>
                </Border>

                <Rectangle Grid.Column="1" Width="1"
                           Fill="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                <Border Grid.Column="2" CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock Text="{Binding HeaderB}" FontWeight="Medium" FontSize="12"/>
                        </Border>
                        <ae:TextEditor x:Name="EditorB"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       FontFamily="Cascadia Code,JetBrains Mono,Consolas,monospace"
                                       FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
