<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Analogi.App.Views.Pages.ComparePage"
             x:DataType="vm:CompareViewModel">

    <DockPanel Margin="28,24">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="Compare" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SimilarityText}"
                       IsVisible="{Binding HasComparison}"
                       FontSize="14" Opacity="0.7"/>
        </StackPanel>

        <!-- Empty state -->
        <Border IsVisible="{Binding !HasComparison}"
                CornerRadius="8" Padding="40"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="No Comparison Selected" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center"/>
                <TextBlock Text="Select a pair from the Results page to view&#10;the side-by-side code comparison."
                           TextAlignment="Center" Opacity="0.6" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Comparison view -->
        <DockPanel IsVisible="{Binding HasComparison}">
            <!-- Reasons panel -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,12,0,0"
                    MaxHeight="130" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Analysis Breakdown" FontWeight="Medium" FontSize="12"/>
                        <TextBlock Text="{Binding ReasonsText}"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" LineHeight="18"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Side-by-side code -->
            <Grid ColumnDefinitions="*,1,*">
                <!-- File A -->
                <Border Grid.Column="0" CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock Text="{Binding FileAName}" FontWeight="Medium" FontSize="12"/>
                        </Border>
                        <ae:TextEditor x:Name="EditorA"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       FontFamily="Cascadia Code,JetBrains Mono,Consolas,monospace"
                                       FontSize="12"/>
                    </DockPanel>
                </Border>

                <!-- Divider -->
                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" Margin="4,0"/>

                <!-- File B -->
                <Border Grid.Column="2" CornerRadius="8"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock Text="{Binding FileBName}" FontWeight="Medium" FontSize="12"/>
                        </Border>
                        <ae:TextEditor x:Name="EditorB"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       FontFamily="Cascadia Code,JetBrains Mono,Consolas,monospace"
                                       FontSize="12"/>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
