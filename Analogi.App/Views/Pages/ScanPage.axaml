<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Analogi.App.Views.Pages.ScanPage"
             x:DataType="vm:ScanViewModel">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="640">
            <!-- Hero -->
            <StackPanel Spacing="4" Margin="0,0,0,8">
                <TextBlock Text="Scan for Code Clones" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Select a folder containing student source files to analyze for similarity."
                           Opacity="0.65" TextWrapping="Wrap" FontSize="13"/>
            </StackPanel>

            <!-- Folder Input Card -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Source Folder" FontWeight="Medium" FontSize="13"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBox Grid.Column="0"
                                 Text="{Binding FolderPath, Mode=TwoWay}"
                                 PlaceholderText="C:\courses\cs101\submissions"
                                 Margin="0,0,10,0"/>
                        <Button Grid.Column="1"
                                Content="Browse"
                                Command="{Binding BrowseCommand}"
                                Padding="16,8"/>
                    </Grid>

                    <CheckBox Content="Submission mode — treat each subfolder as one student"
                              IsChecked="{Binding IsSubmissionMode}"
                              Margin="0,4,0,0"/>

                    <Button Content="Start Scan"
                            Classes="accent"
                            Command="{Binding ScanCommand}"
                            HorizontalAlignment="Left"
                            Padding="24,10"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Progress -->
            <StackPanel IsVisible="{Binding IsScanning}" Spacing="8">
                <ProgressBar Minimum="0"
                             Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7"/>
            </StackPanel>

            <!-- Status (when not scanning) -->
            <TextBlock Text="{Binding StatusText}"
                       IsVisible="{Binding !IsScanning}"
                       TextWrapping="Wrap" FontSize="13" Opacity="0.7"/>

            <!-- Info Cards -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="6" Margin="0,0,12,16">
                        <TextBlock Text="Languages" FontWeight="Medium" FontSize="12"/>
                        <TextBlock Text="C/C++  •  Python  •  Java&#10;C#  •  JavaScript/TypeScript"
                                   FontSize="12" Opacity="0.65" LineHeight="18"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="6" Margin="12,0,0,16">
                        <TextBlock Text="Analysis" FontWeight="Medium" FontSize="12"/>
                        <TextBlock Text="Cosine Similarity  •  Winnowing&#10;Structure  •  Comments  •  Imports"
                                   FontSize="12" Opacity="0.65" LineHeight="18"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
