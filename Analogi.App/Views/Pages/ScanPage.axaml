<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Analogi.App.Views.Pages.ScanPage"
             x:DataType="vm:ScanViewModel">

    <Grid RowDefinitions="*,Auto">
        <!-- Centered hero area -->
        <StackPanel Grid.Row="0" Spacing="20"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="500" Margin="32">

            <!-- Title -->
            <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="Analogi" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Code Clone Detector for Education"
                           FontSize="14" Opacity="0.5" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Drop zone / Input area -->
            <Border x:Name="DropZone" CornerRadius="12" Padding="24,20"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="2" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="14">
                    <!-- Path input -->
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding FolderPath, Mode=TwoWay}"
                                 PlaceholderText="Drop a folder here or type a path..."
                                 Margin="0,0,8,0"
                                 CornerRadius="8"/>
                        <Button Grid.Column="1" Content="Browse"
                                Command="{Binding BrowseCommand}"
                                Padding="16,8" CornerRadius="8"/>
                    </Grid>

                    <!-- Options row -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <CheckBox Content="Submission mode"
                                  IsChecked="{Binding IsSubmissionMode}"
                                  FontSize="12"/>
                    </StackPanel>

                    <!-- Scan button -->
                    <Button Content="Scan"
                            Classes="accent"
                            Command="{Binding ScanCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="0,12" CornerRadius="8" FontWeight="Medium"/>
                </StackPanel>
            </Border>

            <!-- Progress (appears during scan) -->
            <StackPanel IsVisible="{Binding IsScanning}" Spacing="8">
                <ProgressBar Minimum="0" Maximum="{Binding ProgressMax}"
                             Value="{Binding ProgressValue}" CornerRadius="4"/>
                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Status -->
            <TextBlock Text="{Binding StatusText}"
                       IsVisible="{Binding !IsScanning}"
                       HorizontalAlignment="Center"
                       FontSize="12" Opacity="0.5"/>
        </StackPanel>

        <!-- Footer info -->
        <Border Grid.Row="1" Padding="24,12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="32" HorizontalAlignment="Center">
                <TextBlock FontSize="11" Opacity="0.5"
                           Text="C/C++ • Python • Java • C# • JS/TS"/>
                <TextBlock FontSize="11" Opacity="0.5"
                           Text="Cosine • Winnowing • Structure • Comments • Imports"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
