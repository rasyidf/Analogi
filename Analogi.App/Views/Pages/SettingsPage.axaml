<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Analogi.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="720">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="Pipeline Settings" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="Toggle analysis steps on or off. Disabled steps are skipped during scanning."
                           Opacity="0.65" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Pipeline Flow Visualizer -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Pipeline Flow" FontWeight="Medium" FontSize="13"/>
                    <TextBlock Text="Input → Extractors → PreProcessors → Analyzers → Score"
                               FontSize="12" Opacity="0.5" FontFamily="Cascadia Code,Consolas,monospace"/>

                    <!-- Pipeline cards -->
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                <Border Margin="0,0,8,8"
                                        CornerRadius="6"
                                        Padding="12,8"
                                        BorderThickness="1"
                                        Opacity="{Binding Opacity}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- Category dot -->
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding CategoryColor}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Legend -->
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="8" Height="8" Fill="#4FC3F7"/>
                            <TextBlock Text="Extractor" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="8" Height="8" Fill="#FFB74D"/>
                            <TextBlock Text="PreProcessor" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Ellipse Width="8" Height="8" Fill="#81C784"/>
                            <TextBlock Text="Analyzer" FontSize="10" Opacity="0.6"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Toggle List -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Step Controls" FontWeight="Medium" FontSize="13" Margin="0,0,0,8"/>

                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                <Border Padding="12,10" Margin="0,0,0,4"
                                        CornerRadius="6"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Category badge -->
                                        <Border Grid.Column="0" CornerRadius="4"
                                                Padding="8,3" Margin="0,0,12,0"
                                                VerticalAlignment="Center"
                                                MinWidth="90">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding CategoryColor}" Opacity="0.2"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding CategoryColor}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>

                                        <!-- Name -->
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" FontSize="13"/>

                                        <!-- Toggle -->
                                        <ToggleSwitch Grid.Column="2"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
