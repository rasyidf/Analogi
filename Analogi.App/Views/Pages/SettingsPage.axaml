<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Analogi.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="760">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Pipeline Settings" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Toggle steps on/off. Disabled steps are skipped during scanning."
                               Opacity="0.6" FontSize="13"/>
                </StackPanel>
                <!-- Segmented control -->
                <Border Grid.Column="1" CornerRadius="8" Padding="3"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <RadioButton Content="Graph" GroupName="ViewMode"
                                     IsChecked="{Binding IsGraphView}"
                                     Padding="14,7" FontSize="12"
                                     Classes="segmented"/>
                        <RadioButton Content="List" GroupName="ViewMode"
                                     IsChecked="{Binding IsListView}"
                                     Padding="14,7" FontSize="12"
                                     Classes="segmented"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════ GRAPH VIEW ═══════ -->
            <Border IsVisible="{Binding IsGraphView}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="28,24" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="0">
                    <!-- Input -->
                    <Border CornerRadius="20" Padding="16,8" Background="#2E7D32" HorizontalAlignment="Left">
                        <TextBlock Text="Input (Source Files)" FontSize="11" Foreground="White" FontWeight="Medium"/>
                    </Border>

                    <!-- Arrow (uses foreground color = adapts to theme) -->
                    <Canvas Height="30" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,22" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,20 L12,28 L17,20" Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Canvas>

                    <!-- Extractors -->
                    <Border CornerRadius="6" Padding="16,12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="#334FC3F7">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Extractors" FontSize="11" FontWeight="SemiBold" Foreground="#4FC3F7"/>
                            <ItemsControl ItemsSource="{Binding Extractors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                        <Border Margin="0,0,6,6" CornerRadius="4" Padding="10,5"
                                                Opacity="{Binding Opacity}" Cursor="Hand"
                                                Background="#1A4FC3F7" BorderThickness="1" BorderBrush="#4FC3F7"
                                                PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="#4FC3F7" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Opacity="0.6"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Arrow -->
                    <Canvas Height="30" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,22" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,20 L12,28 L17,20" Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Canvas>

                    <!-- PreProcessors -->
                    <Border CornerRadius="6" Padding="16,12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="#33FFB74D">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PreProcessors" FontSize="11" FontWeight="SemiBold" Foreground="#FFB74D"/>
                            <ItemsControl ItemsSource="{Binding PreProcessors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                        <Border Margin="0,0,6,6" CornerRadius="4" Padding="10,5"
                                                Opacity="{Binding Opacity}" Cursor="Hand"
                                                Background="#1AFFB74D" BorderThickness="1" BorderBrush="#FFB74D"
                                                PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="#FFB74D" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Opacity="0.6"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Arrow -->
                    <Canvas Height="30" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,22" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,20 L12,28 L17,20" Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Canvas>

                    <!-- Analyzers -->
                    <Border CornerRadius="6" Padding="16,12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="#3381C784">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Analyzers" FontSize="11" FontWeight="SemiBold" Foreground="#81C784"/>
                            <ItemsControl ItemsSource="{Binding Analyzers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                        <Border Margin="0,0,6,6" CornerRadius="4" Padding="10,5"
                                                Opacity="{Binding Opacity}" Cursor="Hand"
                                                Background="#1A81C784" BorderThickness="1" BorderBrush="#81C784"
                                                PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="#81C784" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Opacity="0.6"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Arrow -->
                    <Canvas Height="30" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,22" Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,20 L12,28 L17,20" Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Canvas>

                    <!-- Output -->
                    <Border CornerRadius="20" Padding="16,8" Background="#C62828" HorizontalAlignment="Left">
                        <TextBlock Text="Output (Similarity Score)" FontSize="11" Foreground="White" FontWeight="Medium"/>
                    </Border>

                    <TextBlock Text="Click a step to toggle on/off" FontSize="11" Opacity="0.35" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══════ LIST VIEW (grouped) ═══════ -->
            <StackPanel IsVisible="{Binding IsListView}" Spacing="12">
                <!-- Extractors group -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20,16" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Extractors" FontWeight="SemiBold" FontSize="13" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Extractors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                    <Border Padding="14,10" Margin="0,0,0,3" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                          OnContent="On" OffContent="Off"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- PreProcessors group -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20,16" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="PreProcessors" FontWeight="SemiBold" FontSize="13" Foreground="#FFB74D" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding PreProcessors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                    <Border Padding="14,10" Margin="0,0,0,3" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                          OnContent="On" OffContent="Off"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Analyzers group -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Padding="20,16" BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Analyzers" FontWeight="SemiBold" FontSize="13" Foreground="#81C784" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Analyzers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                    <Border Padding="14,10" Margin="0,0,0,3" CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                                          OnContent="On" OffContent="Off"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
