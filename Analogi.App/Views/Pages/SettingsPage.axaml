<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Analogi.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="20" MaxWidth="760">
            <!-- Header with view toggle -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Pipeline Settings" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Toggle steps on/off. Disabled steps are skipped during scanning."
                               Opacity="0.6" FontSize="13"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="6" Padding="2"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button Content="Graph" Command="{Binding SetViewCommand}" CommandParameter="Graph"
                                Padding="14,6" FontSize="11" CornerRadius="4"/>
                        <Button Content="List" Command="{Binding SetViewCommand}" CommandParameter="List"
                                Padding="14,6" FontSize="11" CornerRadius="4"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════ GRAPH VIEW ═══════ -->
            <Border IsVisible="{Binding IsGraphView}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="28,24" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="0">
                    <!-- Input node -->
                    <Border CornerRadius="20" Padding="16,8"
                            Background="#2E7D32" HorizontalAlignment="Left">
                        <TextBlock Text="Input (Source Files)" FontSize="11" Foreground="White" FontWeight="Medium"/>
                    </Border>

                    <!-- Arrow -->
                    <Canvas Height="32" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,24" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,22 L12,30 L17,22" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- Extractors section -->
                    <Border CornerRadius="6" Padding="16,12" Margin="0,0,0,0"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="#334FC3F7">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Extractors" FontSize="11" FontWeight="SemiBold" Foreground="#4FC3F7"/>
                            <ItemsControl ItemsSource="{Binding Extractors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                        <Border Margin="0,0,6,6" CornerRadius="4" Padding="10,5"
                                                Opacity="{Binding Opacity}" Cursor="Hand"
                                                Background="#1A4FC3F7" BorderThickness="1" BorderBrush="#4FC3F7"
                                                PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="#4FC3F7" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Opacity="0.6"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Arrow -->
                    <Canvas Height="32" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,24" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,22 L12,30 L17,22" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- PreProcessors section -->
                    <Border CornerRadius="6" Padding="16,12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="#33FFB74D">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PreProcessors" FontSize="11" FontWeight="SemiBold" Foreground="#FFB74D"/>
                            <ItemsControl ItemsSource="{Binding PreProcessors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                        <Border Margin="0,0,6,6" CornerRadius="4" Padding="10,5"
                                                Opacity="{Binding Opacity}" Cursor="Hand"
                                                Background="#1AFFB74D" BorderThickness="1" BorderBrush="#FFB74D"
                                                PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="#FFB74D" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Opacity="0.6"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Arrow -->
                    <Canvas Height="32" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,24" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,22 L12,30 L17,22" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- Analyzers section -->
                    <Border CornerRadius="6" Padding="16,12"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                            BorderThickness="1" BorderBrush="#3381C784">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Analyzers" FontSize="11" FontWeight="SemiBold" Foreground="#81C784"/>
                            <ItemsControl ItemsSource="{Binding Analyzers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                        <Border Margin="0,0,6,6" CornerRadius="4" Padding="10,5"
                                                Opacity="{Binding Opacity}" Cursor="Hand"
                                                Background="#1A81C784" BorderThickness="1" BorderBrush="#81C784"
                                                PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <Ellipse Width="6" Height="6" Fill="#81C784" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11"/>
                                                <TextBlock Text="{Binding StatusIcon}" FontSize="9" Opacity="0.6"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Arrow -->
                    <Canvas Height="32" Width="24" HorizontalAlignment="Left" Margin="24,0,0,0">
                        <Line StartPoint="12,2" EndPoint="12,24" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="1.5"/>
                        <Path Data="M7,22 L12,30 L17,22" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- Output node -->
                    <Border CornerRadius="20" Padding="16,8"
                            Background="#C62828" HorizontalAlignment="Left">
                        <TextBlock Text="Output (Similarity Score)" FontSize="11" Foreground="White" FontWeight="Medium"/>
                    </Border>

                    <TextBlock Text="Click a step to toggle on/off" FontSize="11" Opacity="0.4" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══════ LIST VIEW ═══════ -->
            <Border IsVisible="{Binding IsListView}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="24,20" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Step Controls" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                <Border Padding="14,10" Margin="0,0,0,3"
                                        CornerRadius="6"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" CornerRadius="4"
                                                Padding="8,3" Margin="0,0,12,0"
                                                VerticalAlignment="Center" MinWidth="90">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding CategoryColor}" Opacity="0.12"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       HorizontalAlignment="Center" FontWeight="Medium">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding CategoryColor}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <ToggleSwitch Grid.Column="2"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center"
                                                      OnContent="On" OffContent="Off"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
