<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="Analogi.App.Views.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24" MaxWidth="760">
            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Pipeline Settings" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="Toggle steps on/off. Disabled steps are skipped during scanning."
                               Opacity="0.65" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- View toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                    <Button Content="Graph" Command="{Binding SetViewCommand}" CommandParameter="Graph"
                            Padding="12,6" FontSize="12"/>
                    <Button Content="List" Command="{Binding SetViewCommand}" CommandParameter="List"
                            Padding="12,6" FontSize="12"/>
                </StackPanel>
            </Grid>

            <!-- ═══════ GRAPH VIEW ═══════ -->
            <Border IsVisible="{Binding IsGraphView}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="24" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="0">
                    <!-- Input node -->
                    <Border CornerRadius="6" Padding="14,8"
                            Background="#2E7D32" HorizontalAlignment="Left">
                        <TextBlock Text="Input (Source Files)" FontSize="12" Foreground="White" FontWeight="Medium"/>
                    </Border>

                    <!-- Arrow down -->
                    <Canvas Height="28" Width="20" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <Line StartPoint="10,0" EndPoint="10,20" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="2"/>
                        <Path Data="M5,18 L10,26 L15,18" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- Extractors -->
                    <TextBlock Text="Extractors" FontSize="11" FontWeight="Medium" Opacity="0.6" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Extractors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                <Border Margin="0,0,6,6" CornerRadius="5" Padding="10,6"
                                        Opacity="{Binding Opacity}" Cursor="Hand"
                                        Background="#1A4FC3F7" BorderThickness="1.5" BorderBrush="#4FC3F7"
                                        PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" Fill="#4FC3F7" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Arrow down -->
                    <Canvas Height="28" Width="20" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <Line StartPoint="10,0" EndPoint="10,20" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="2"/>
                        <Path Data="M5,18 L10,26 L15,18" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- PreProcessors -->
                    <TextBlock Text="PreProcessors" FontSize="11" FontWeight="Medium" Opacity="0.6" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding PreProcessors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                <Border Margin="0,0,6,6" CornerRadius="5" Padding="10,6"
                                        Opacity="{Binding Opacity}" Cursor="Hand"
                                        Background="#1AFFB74D" BorderThickness="1.5" BorderBrush="#FFB74D"
                                        PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" Fill="#FFB74D" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Arrow down -->
                    <Canvas Height="28" Width="20" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <Line StartPoint="10,0" EndPoint="10,20" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="2"/>
                        <Path Data="M5,18 L10,26 L15,18" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- Analyzers -->
                    <TextBlock Text="Analyzers" FontSize="11" FontWeight="Medium" Opacity="0.6" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Analyzers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                <Border Margin="0,0,6,6" CornerRadius="5" Padding="10,6"
                                        Opacity="{Binding Opacity}" Cursor="Hand"
                                        Background="#1A81C784" BorderThickness="1.5" BorderBrush="#81C784"
                                        PointerPressed="StepCard_PointerPressed" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="7" Height="7" Fill="#81C784" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="10" Opacity="0.7" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Arrow down -->
                    <Canvas Height="28" Width="20" HorizontalAlignment="Left" Margin="20,0,0,0">
                        <Line StartPoint="10,0" EndPoint="10,20" Stroke="{DynamicResource CardStrokeColorDefaultBrush}" StrokeThickness="2"/>
                        <Path Data="M5,18 L10,26 L15,18" Fill="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    </Canvas>

                    <!-- Output node -->
                    <Border CornerRadius="6" Padding="14,8"
                            Background="#C62828" HorizontalAlignment="Left">
                        <TextBlock Text="Output (Similarity Score)" FontSize="12" Foreground="White" FontWeight="Medium"/>
                    </Border>

                    <!-- Hint -->
                    <TextBlock Text="Click a step to toggle it on/off" FontSize="11" Opacity="0.4" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══════ LIST VIEW ═══════ -->
            <Border IsVisible="{Binding IsListView}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="8" Padding="24" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Step Controls" FontWeight="Medium" FontSize="14" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PipelineStepViewModel">
                                <Border Padding="14,10" Margin="0,0,0,4"
                                        CornerRadius="6"
                                        Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Grid.Column="0" CornerRadius="4"
                                                Padding="8,3" Margin="0,0,12,0"
                                                VerticalAlignment="Center" MinWidth="95">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding CategoryColor}" Opacity="0.15"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Category}" FontSize="10"
                                                       HorizontalAlignment="Center" FontWeight="Medium">
                                                <TextBlock.Foreground>
                                                    <SolidColorBrush Color="{Binding CategoryColor}"/>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                   VerticalAlignment="Center" FontSize="13"/>
                                        <ToggleSwitch Grid.Column="2"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center"
                                                      OnContent="On" OffContent="Off"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
