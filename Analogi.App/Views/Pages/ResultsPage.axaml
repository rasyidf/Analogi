<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Analogi.App.Views.Pages.ResultsPage"
             x:DataType="vm:ResultsViewModel">

    <DockPanel Margin="28,24">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Results" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SummaryText}" FontSize="13" Opacity="0.65"/>

            <!-- Filter bar -->
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Show:" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,0,4,0"/>
                    <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" Padding="12,6" FontSize="12"/>
                    <Button Content="High +" Command="{Binding SetFilterCommand}" CommandParameter="High" Padding="12,6" FontSize="12"/>
                    <Button Content="Moderate +" Command="{Binding SetFilterCommand}" CommandParameter="Moderate" Padding="12,6" FontSize="12"/>
                    <Button Content="Low +" Command="{Binding SetFilterCommand}" CommandParameter="Low" Padding="12,6" FontSize="12"/>
                    <TextBlock Text="{Binding FilterLabel, StringFormat='Filter: {0}'}"
                               VerticalAlignment="Center" FontSize="11" Opacity="0.5" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Results grid -->
        <DataGrid ItemsSource="{Binding FilteredResults}"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="False"
                  x:CompileBindings="False"
                  SelectionChanged="DataGrid_SelectionChanged"
                  CornerRadius="6"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File A" Binding="{Binding FileA.Name}" Width="*"/>
                <DataGridTextColumn Header="File B" Binding="{Binding FileB.Name}" Width="*"/>
                <DataGridTextColumn Header="Similarity" Binding="{Binding SimilarityPercent, StringFormat={}{0}%}" Width="100"/>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                <DataGridTextColumn Header="Reasons" Binding="{Binding Reasons.Count}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
