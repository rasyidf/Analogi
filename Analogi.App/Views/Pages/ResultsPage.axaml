<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Analogi.App.ViewModels.Pages"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Analogi.App.Views.Pages.ResultsPage"
             x:DataType="vm:ResultsViewModel">

    <DockPanel Margin="28,24">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Command="{Binding GoBackCommand}"
                        Padding="8,6" Background="Transparent" CornerRadius="6"
                        VerticalAlignment="Center" ToolTip.Tip="Back to Scan">
                    <PathIcon Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                              Width="16" Height="16"/>
                </Button>
                <TextBlock Text="Results" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding SummaryText}" FontSize="13" Opacity="0.65"/>

            <!-- Filter bar (only when has results) -->
            <Border IsVisible="{Binding HasResults}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,10,0,0"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Show:" VerticalAlignment="Center" FontSize="12" Opacity="0.7" Margin="0,0,4,0"/>
                    <Button Content="All" Command="{Binding SetFilterCommand}" CommandParameter="All" Padding="12,6" FontSize="12"/>
                    <Button Content="High +" Command="{Binding SetFilterCommand}" CommandParameter="High" Padding="12,6" FontSize="12"/>
                    <Button Content="Moderate +" Command="{Binding SetFilterCommand}" CommandParameter="Moderate" Padding="12,6" FontSize="12"/>
                    <Button Content="Low +" Command="{Binding SetFilterCommand}" CommandParameter="Low" Padding="12,6" FontSize="12"/>
                    <TextBlock Text="{Binding FilterLabel, StringFormat='Filter: {0}'}"
                               VerticalAlignment="Center" FontSize="11" Opacity="0.5" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Empty state -->
        <Border IsVisible="{Binding !HasResults}"
                CornerRadius="8" Padding="48"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="10" HorizontalAlignment="Center">
                <PathIcon Data="M2.75 4.5a.75.75 0 0 0 0 1.5h18.5a.75.75 0 0 0 0-1.5H2.75zm0 7a.75.75 0 0 0 0 1.5h18.5a.75.75 0 0 0 0-1.5H2.75zm0 7a.75.75 0 0 0 0 1.5h18.5a.75.75 0 0 0 0-1.5H2.75z"
                          Width="32" Height="32" Opacity="0.3"/>
                <TextBlock Text="No Results Yet" FontSize="16" FontWeight="Medium" HorizontalAlignment="Center"/>
                <TextBlock Text="Run a scan first to see similarity results here."
                           TextAlignment="Center" Opacity="0.5" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- Results grid -->
        <DataGrid IsVisible="{Binding HasResults}"
                  ItemsSource="{Binding FilteredResults}"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  CanUserSortColumns="True"
                  AutoGenerateColumns="False"
                  x:CompileBindings="False"
                  DoubleTapped="DataGrid_DoubleTapped"
                  CornerRadius="6"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name A" Binding="{Binding NameA}" Width="*"/>
                <DataGridTextColumn Header="Name B" Binding="{Binding NameB}" Width="*"/>
                <DataGridTextColumn Header="Similarity" Binding="{Binding SimilarityPercent, StringFormat={}{0}%}" Width="100"/>
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                <DataGridTextColumn Header="Reasons" Binding="{Binding ReasonCount}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
