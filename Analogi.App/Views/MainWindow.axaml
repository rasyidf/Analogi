<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Analogi.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Analogi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Analogi"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar -->
        <Border Grid.Column="0"
                Padding="12,44,12,12">
            <DockPanel>
                <!-- App title at top -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,20">
                    <TextBlock Text="Analogi" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Code Clone Detector"
                               FontSize="11"
                               Opacity="0.6"/>
                </StackPanel>

                <!-- Navigation -->
                <ListBox x:Name="NavList"
                         SelectionChanged="NavList_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         CornerRadius="6">
                    <ListBoxItem Content="Scan" Tag="ScanPage" Padding="12,10"/>
                    <ListBoxItem Content="Results" Tag="ResultsPage" Padding="12,10"/>
                    <ListBoxItem Content="Compare" Tag="ComparePage" Padding="12,10"/>
                    <ListBoxItem Content="About" Tag="AboutPage" Padding="12,10"/>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <Border Grid.Column="1"
                CornerRadius="8,0,0,0"
                Margin="0,32,0,0"
                ClipToBounds="True">
            <TransitioningContentControl x:Name="ContentFrame"/>
        </Border>
    </Grid>
</Window>
