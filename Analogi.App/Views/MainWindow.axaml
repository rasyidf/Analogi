<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Analogi.App.ViewModels"
        xmlns:pages="using:Analogi.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Analogi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Analogi — Code Clone Detector"
        Width="1050" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <SplitView IsPaneOpen="True"
               DisplayMode="CompactInline"
               OpenPaneLength="180"
               CompactPaneLength="48">
        <SplitView.Pane>
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    Padding="0,8">
                <StackPanel Spacing="4">
                    <ListBox x:Name="NavList"
                             SelectionChanged="NavList_SelectionChanged"
                             SelectedIndex="0"
                             Margin="4">
                        <ListBoxItem Content="⊞  Scan" Tag="ScanPage"/>
                        <ListBoxItem Content="☰  Results" Tag="ResultsPage"/>
                        <ListBoxItem Content="⇄  Compare" Tag="ComparePage"/>
                        <ListBoxItem Content="ⓘ  About" Tag="AboutPage"/>
                    </ListBox>
                </StackPanel>
            </Border>
        </SplitView.Pane>

        <SplitView.Content>
            <TransitioningContentControl x:Name="ContentFrame"/>
        </SplitView.Content>
    </SplitView>
</Window>
