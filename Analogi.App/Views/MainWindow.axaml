<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Analogi.App.ViewModels"
        xmlns:pages="using:Analogi.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Analogi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Analogi — Code Clone Detector"
        Width="1050" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <ui:NavigationView x:Name="NavView"
                       PaneDisplayMode="Left"
                       IsSettingsVisible="False"
                       IsPaneOpen="True"
                       OpenPaneLength="200"
                       SelectionChanged="NavView_SelectionChanged">
        <ui:NavigationView.MenuItems>
            <ui:NavigationViewItem Content="Scan" Tag="ScanPage" IconSource="Find"/>
            <ui:NavigationViewItem Content="Results" Tag="ResultsPage" IconSource="List"/>
            <ui:NavigationViewItem Content="Compare" Tag="ComparePage" IconSource="Copy"/>
        </ui:NavigationView.MenuItems>

        <ui:NavigationView.FooterMenuItems>
            <ui:NavigationViewItem Content="About" Tag="AboutPage" IconSource="Help"/>
        </ui:NavigationView.FooterMenuItems>

        <ui:NavigationView.Content>
            <TransitioningContentControl x:Name="ContentFrame"/>
        </ui:NavigationView.Content>
    </ui:NavigationView>
</Window>
