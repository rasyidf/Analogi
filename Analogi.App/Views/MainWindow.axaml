<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Analogi.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Analogi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Analogi"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="52,*" Margin="0,32,0,0">
        <!-- Sidebar -->
        <Border Grid.Column="0" Padding="0,8,0,8">
            <DockPanel>
                <!-- Bottom: Settings, About, Theme -->
                <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center" Spacing="2">
                    <ListBox x:Name="NavListBottom"
                             SelectionChanged="NavList_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             HorizontalAlignment="Center">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Width" Value="36"/>
                                <Setter Property="Height" Value="36"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBoxItem Tag="Settings" ToolTip.Tip="Settings">
                            <!-- Fluent: Settings -->
                            <PathIcon Data="M12.012 2.25c.734.008 1.465.093 2.182.253a.75.75 0 0 1 .582.649l.17 1.527a1.384 1.384 0 0 0 1.927 1.116l1.401-.615a.75.75 0 0 1 .85.174 9.792 9.792 0 0 1 2.204 3.792.75.75 0 0 1-.271.825l-1.242.916a1.381 1.381 0 0 0 0 2.226l1.243.915a.75.75 0 0 1 .272.826 9.797 9.797 0 0 1-2.204 3.792.75.75 0 0 1-.848.175l-1.407-.617a1.38 1.38 0 0 0-1.926 1.114l-.169 1.526a.75.75 0 0 1-.572.647 9.518 9.518 0 0 1-4.406 0 .75.75 0 0 1-.572-.647l-.168-1.524a1.382 1.382 0 0 0-1.926-1.11l-1.406.616a.75.75 0 0 1-.849-.175 9.798 9.798 0 0 1-2.204-3.796.75.75 0 0 1 .272-.826l1.243-.916a1.38 1.38 0 0 0 0-2.226l-1.243-.914a.75.75 0 0 1-.271-.826 9.793 9.793 0 0 1 2.204-3.792.75.75 0 0 1 .85-.174l1.4.615a1.387 1.387 0 0 0 1.93-1.118l.17-1.526a.75.75 0 0 1 .583-.65c.717-.159 1.45-.243 2.201-.252zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"
                                      Width="16" Height="16"/>
                        </ListBoxItem>
                        <ListBoxItem Tag="About" ToolTip.Tip="About">
                            <!-- Fluent: Info -->
                            <PathIcon Data="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2zm0 9h-1a1 1 0 0 0-.117 1.993L11 13v3.5a.5.5 0 0 0 .41.492l.09.008h1a1 1 0 0 0 .117-1.993L12.5 15v-3.5a.5.5 0 0 0-.41-.492L12 11zm0-3.5a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5z"
                                      Width="16" Height="16"/>
                        </ListBoxItem>
                    </ListBox>
                    <Button HorizontalAlignment="Center"
                            Padding="8" Background="Transparent" CornerRadius="6"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="Toggle theme">
                        <!-- Fluent: Dark theme -->
                        <PathIcon Data="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10zm0-2V4a8 8 0 1 1 0 16z"
                                  Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <!-- Top: main pages -->
                <ListBox x:Name="NavList"
                         SelectionChanged="NavList_SelectionChanged"
                         SelectedIndex="0"
                         Background="Transparent" BorderThickness="0"
                         HorizontalAlignment="Center">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="CornerRadius" Value="6"/>
                            <Setter Property="Width" Value="36"/>
                            <Setter Property="Height" Value="36"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBoxItem Tag="Scan" ToolTip.Tip="Scan">
                        <!-- Fluent: Scan/Document search -->
                        <PathIcon Data="M11.5 2a9.5 9.5 0 0 1 6.38 16.55l4.03 4.03a.75.75 0 0 1-1.06 1.06l-4.03-4.03A9.5 9.5 0 1 1 11.5 2zm0 1.5a8 8 0 1 0 0 16 8 8 0 0 0 0-16z"
                                  Width="16" Height="16"/>
                    </ListBoxItem>
                    <ListBoxItem Tag="Results" ToolTip.Tip="Results">
                        <!-- Fluent: List -->
                        <PathIcon Data="M2.75 4.5a.75.75 0 0 0 0 1.5h18.5a.75.75 0 0 0 0-1.5H2.75zm0 7a.75.75 0 0 0 0 1.5h18.5a.75.75 0 0 0 0-1.5H2.75zm0 7a.75.75 0 0 0 0 1.5h18.5a.75.75 0 0 0 0-1.5H2.75z"
                                  Width="16" Height="16"/>
                    </ListBoxItem>
                    <ListBoxItem Tag="Compare" ToolTip.Tip="Compare">
                        <!-- Fluent: Split -->
                        <PathIcon Data="M8.293 3.293a1 1 0 0 1 1.414 0l4 4a1 1 0 0 1-1.414 1.414L10 6.414V17.5a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5V6.414L5.707 8.707a1 1 0 0 1-1.414-1.414l4-4zM14 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v11.086l2.293-2.293a1 1 0 0 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 1.414-1.414L14 17.586V6.5z"
                                  Width="16" Height="16"/>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Border Grid.Column="1"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="8,0,0,0" ClipToBounds="True">
            <TransitioningContentControl x:Name="ContentFrame"/>
        </Border>
    </Grid>
</Window>
