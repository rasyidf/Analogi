<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Analogi.App.ViewModels"
        xmlns:pages="using:Analogi.App.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Analogi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Analogi"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <!-- Top nav bar -->
        <Border DockPanel.Dock="Top" Padding="16,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- App title -->
                <TextBlock Grid.Column="0" Text="Analogi"
                           FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>

                <!-- Navigation tabs -->
                <TabStrip Grid.Column="1" x:Name="NavTabs"
                          SelectedIndex="0"
                          SelectionChanged="NavTabs_SelectionChanged">
                    <TabStripItem Content="Scan"/>
                    <TabStripItem Content="Results"/>
                    <TabStripItem Content="Compare"/>
                    <TabStripItem Content="Settings"/>
                    <TabStripItem Content="About"/>
                </TabStrip>
            </Grid>
        </Border>

        <!-- Content -->
        <TransitioningContentControl x:Name="ContentFrame"/>
    </DockPanel>
</Window>
