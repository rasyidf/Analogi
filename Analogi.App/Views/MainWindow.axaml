<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Analogi.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="Analogi.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Analogi"
        Width="1100" Height="720"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="56,*">
        <!-- Sidebar rail (NavigationView compact style) -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <!-- Bottom: Theme toggle -->
                <Button DockPanel.Dock="Bottom"
                        Content="◑"
                        FontSize="18"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Padding="8"
                        Background="Transparent"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip.Tip="Toggle theme"/>

                <!-- Nav items -->
                <ListBox x:Name="NavList"
                         SelectionChanged="NavList_SelectionChanged"
                         SelectedIndex="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,8,0,0"
                         HorizontalAlignment="Center">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="10,12"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="CornerRadius" Value="8"/>
                            <Setter Property="Width" Value="42"/>
                            <Setter Property="Height" Value="42"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBoxItem Tag="Scan" ToolTip.Tip="Scan">
                        <TextBlock Text="⊞" FontSize="18"/>
                    </ListBoxItem>
                    <ListBoxItem Tag="Results" ToolTip.Tip="Results">
                        <TextBlock Text="☰" FontSize="18"/>
                    </ListBoxItem>
                    <ListBoxItem Tag="Compare" ToolTip.Tip="Compare">
                        <TextBlock Text="⇄" FontSize="18"/>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings" ToolTip.Tip="Settings">
                        <TextBlock Text="⚙" FontSize="18"/>
                    </ListBoxItem>
                    <ListBoxItem Tag="About" ToolTip.Tip="About">
                        <TextBlock Text="ⓘ" FontSize="18"/>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content area -->
        <TransitioningContentControl Grid.Column="1" x:Name="ContentFrame"/>
    </Grid>
</Window>
